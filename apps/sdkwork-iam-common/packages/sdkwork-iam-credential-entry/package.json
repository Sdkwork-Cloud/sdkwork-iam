{
  "name": "@sdkwork/iam-credential-entry",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "SDKWork IAM credential-entry bootstrap transport for login, registration, and QR flows.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./vite": {
      "types": "./src/vite.ts",
      "import": "./src/vite.ts",
      "default": "./src/vite.ts"
    },
    "./node-bootstrap": {
      "types": "./src/node-bootstrap.d.mts",
      "import": "./src/node-bootstrap.mjs",
      "default": "./src/node-bootstrap.mjs"
    },
    "./renderer-dev-bootstrap": {
      "types": "./src/renderer-dev-bootstrap.d.mts",
      "import": "./src/renderer-dev-bootstrap.mjs",
      "default": "./src/renderer-dev-bootstrap.mjs"
    }
  },
  "bin": {
    "sdkwork-iam-renderer-dev-bootstrap": "./src/bin/renderer-dev-bootstrap.mjs"
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "pnpm --dir ../../../.. exec vitest run apps/sdkwork-iam-common/packages/sdkwork-iam-credential-entry/tests --config vitest.node.config.ts --configLoader native --pool vmThreads"
  },
  "devDependencies": {
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "@sdkwork/iam-app-sdk": "workspace:*",
    "@sdkwork/sdk-common": "^1.0.2",
    "@sdkwork/utils": "workspace:*"
  },
  "sdkwork": {
    "architecture": "common",
    "capability": "iam-credential-entry",
    "domain": "iam",
    "packageType": "runtime",
    "status": "standard"
  }
}
